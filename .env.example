# Copy this file to .env and fill in local secrets. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ieee_repo

# Required by web/app.py. Store only password hashes, never plaintext passwords.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
APP_SECRET_KEY=
# 1: MySQL accounts (normal mode). 0: legacy .env account hashes.
ACCOUNT_AUTH_ENABLED=1
SESSION_COOKIE_SECURE=0
TEMPLATES_AUTO_RELOAD=1
# Existing Obsidian vault for create-once review notes; web access is limited to admin.
OBSIDIAN_VAULT_PATH=
# Optional. Defaults to py_01_data/06_personal_reviews; source PDFs are never edited.
REVIEW_MEDIA_DIR=
# Optional. Uses the installed Acrobat executable when empty.
ACROBAT_EXECUTABLE=
ACCOUNT_ACTIVITY_ENABLED=1

YONSEI_ID=
YONSEI_PW=

ZOTERO_USER_ID=
ZOTERO_API_KEY=

IEEE_API_KEY=
# Shared server safeguard across citation maps and favorite-count updates.
# Actual IEEE key limits are assigned by IEEE; this is a local rolling-24h cap.
IEEE_API_DAILY_LIMIT=50
IEEE_API_MIN_INTERVAL_SECONDS=2
OPENALEX_API_KEY=
CROSSREF_MAILTO=

# Local AI Research Desk. Only loopback Ollama endpoints are accepted.
LOCAL_AI_OLLAMA_URL=http://127.0.0.1:11434
LOCAL_AI_ENABLED=1
# Archived favorite-ranking experiments only; the deployed recommendation API is SQL-only.
LOCAL_AI_RECO_ENABLED=0
# Archived AI experiment: per refresh max 256. Deployed SQL recommendations allow max 180.
LOCAL_AI_RECO_CANDIDATES=64
# Offline experiment setting. Experimental pair mode is not quality-approved.
LOCAL_AI_RECO_RANKING=compact
# Automatic refresh quiet period (manual refresh bypasses this delay).
LOCAL_AI_RECO_AUTO_DELAY=45
