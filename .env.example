# Copy this file to .env and fill in local secrets. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=ieee_repo

# Required by web/app.py. Store only password hashes, never plaintext passwords.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
APP_SECRET_KEY=
SESSION_COOKIE_SECURE=0
TEMPLATES_AUTO_RELOAD=1

YONSEI_ID=
YONSEI_PW=

ZOTERO_USER_ID=
ZOTERO_API_KEY=

IEEE_API_KEY=
OPENALEX_API_KEY=
CROSSREF_MAILTO=

# Local AI Research Desk. Only loopback Ollama endpoints are accepted.
LOCAL_AI_OLLAMA_URL=http://127.0.0.1:11434
LOCAL_AI_ENABLED=1
# Archived favorite-ranking experiments only; the deployed recommendation API is SQL-only.
LOCAL_AI_RECO_ENABLED=0
# Archived AI experiment: per refresh max 256. Deployed SQL recommendations allow max 180.
LOCAL_AI_RECO_CANDIDATES=64
# Offline experiment setting. Experimental pair mode is not quality-approved.
LOCAL_AI_RECO_RANKING=compact
# Automatic refresh quiet period (manual refresh bypasses this delay).
LOCAL_AI_RECO_AUTO_DELAY=45
